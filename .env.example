# Preencha com os dados do seu projeto Supabase
VITE_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="SUA_CHAVE_ANON_AQUI"
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_REF"

# Rastreamento de erro (Sentry). Opcional: sem esta variável o monitoramento
# simplesmente não sobe, que é como se roda em desenvolvimento e como se
# desliga em produção sem precisar de deploy de código.
#
# O DSN é público por desenho — vai no bundle do navegador —, então não é
# segredo. Ainda assim fica como variável de ambiente para o ambiente de
# desenvolvimento não poluir os erros de produção.
VITE_SENTRY_DSN=""
