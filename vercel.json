{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "serverless/**"
    },
    "api/trpc/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "serverless/**"
    },
    "api/webhooks/asaas.ts": {
      "maxDuration": 60,
      "includeFiles": "serverless/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/automacao", "schedule": "0 9 * * *" }
  ]
}
