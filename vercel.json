{
  "rewrites": [
    {
      "source": "/cadastro/:code",
      "destination": "https://jbkrxrfdrmrkyldrrdpq.supabase.co/functions/v1/ativar-cadastro/:code"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/cadastro/:code",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'unsafe-inline'" }
      ]
    }
  ]
}
